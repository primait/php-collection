{
    "name": "prima-assicurazioni/php-collection",
    "description": "General-Purpose Collection Library for PHP",
    "keywords": ["collection", "list", "sequence", "map", "set"],
    "license": "Apache-2.0",
    "authors": [
        {"name": "Johannes M. Schmitt", "email": "schmittjoh@gmail.com"},
        {"name": "Mattia Basone", "email": "mattia.basone@gmail.com"}
    ],
    "require": {
        "php": "^8.3",
        "phpoption/phpoption": "1.*"
    },
    "autoload": {
        "psr-0": {
            "PhpCollection": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon --ansi",
        "format": "vendor/bin/php-cs-fixer fix --show-progress=dots --verbose --diff",
        "test": "vendor/bin/phpunit"
    }
}
